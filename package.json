{
  "name": "cuento-frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "prestart": "node -e \"import('fs').then(({existsSync,copyFileSync})=>{if(!existsSync('src/locale_config.ts')&&existsSync('src/locale_config_default.ts')){copyFileSync('src/locale_config_default.ts','src/locale_config.ts');console.log('[start] locale_config.ts copied from default')}})\"",
    "start": "ng serve",
    "build": "node custom-templates.plugin.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:visual": "playwright test tests/visual-tour.spec.ts",
    "test:browserstack": "browserstack-node-sdk playwright test tests/visual-tour.spec.ts",
    "postinstall": "npm update browserstack-node-sdk",
    "test:visual-browserstack": "browserstack-node-sdk playwright test tests/visual-tour.spec.ts"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^19.2.17",
    "@angular/common": "^19.2.0",
    "@angular/compiler": "^19.2.0",
    "@angular/core": "^19.2.0",
    "@angular/elements": "^19.2.17",
    "@angular/forms": "^19.2.0",
    "@angular/platform-browser": "^19.2.0",
    "@angular/platform-browser-dynamic": "^19.2.0",
    "@angular/router": "^19.2.0",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/state": "^6.6.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.42.1",
    "chart.js": "^4.5.1",
    "codemirror": "^6.0.2",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.2.19",
    "@angular/cli": "^19.2.19",
    "@angular/compiler-cli": "^19.2.0",
    "@angular/localize": "^19.2.17",
    "@playwright/test": "^1.58.2",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^25.5.0",
    "browserstack-node-sdk": "^1.53.0",
    "jasmine-core": "~5.6.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~5.7.2"
  }
}
